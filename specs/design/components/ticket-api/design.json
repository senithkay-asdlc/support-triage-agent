{
  "name": "ticket-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "ticket-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9
  ],
  "description": "Owns the ticket queue: accepts new tickets pushed by external ticketing systems on a public, credential-checked endpoint, calls triage-agent to classify urgency and draft a reply, and serves the protected queue/detail/approve/reject/override operations the Support Agent console calls. Records every state change as a ticket event for the audit history. Does not send the approved reply to the customer — that is another system's job — and holds no per-agent ticket assignment.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "tickets-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "support-triage-ag-9cf114e0",
        "envBindings": {
          "dbname": "TICKETS_DB_DBNAME",
          "host": "TICKETS_DB_HOST",
          "password": "TICKETS_DB_PASSWORD",
          "port": "TICKETS_DB_PORT",
          "user": "TICKETS_DB_USER"
        }
      }
    },
    {
      "kind": "component",
      "name": "triage-agent",
      "description": "Classifies a newly-submitted ticket's urgency and drafts its reply, and drafts a fresh reply when a Support Agent rejects one.",
      "wiring": {
        "endpoint": {
          "component": "support-triage-agent-triage-agent",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TRIAGE_AGENT_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "support-triage-ag-1348a372",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
