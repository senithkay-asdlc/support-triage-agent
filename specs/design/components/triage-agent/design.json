{
  "name": "triage-agent",
  "type": "ai-agent",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "triage-agent",
  "entrypoint": "deployment/ai-agent",
  "exposure": "internet",
  "stories": [
    2,
    3
  ],
  "description": "Given a ticket's subject and body, classifies its urgency (Low/Medium/High/Critical) and drafts a candidate reply. Called internally by ticket-api on ticket submission and again on rejection to produce a fresh draft. Calls no other component's API and holds no ticket data of its own beyond its conversation store.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "triage-memory-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "support-triage-ag-6dd5b6ab",
        "envBindings": {
          "dbname": "TRIAGE_MEMORY_DB_DBNAME",
          "host": "TRIAGE_MEMORY_DB_HOST",
          "password": "TRIAGE_MEMORY_DB_PASSWORD",
          "port": "TRIAGE_MEMORY_DB_PORT",
          "user": "TRIAGE_MEMORY_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "support-triage-ag-1348a372",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "agent-building"
  ]
}
